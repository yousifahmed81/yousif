@page "/services"
@rendermode InteractiveServer
@inject IDialogService DialogService
@using ClassLibrary.domian
@using Library.ServicesInterfaces
 @using Library.Services

<h3>Service</h3>
<br />
<div style="float:inline-end">
    <FluentButton Appearance="Appearance.Accent" @onclick="ShowAddModal">Add new Service</FluentButton>
</div>

@if (services == null)
{
    <span>Loading...</span>
}

else
{
    <FluentDataGrid Items="@services"
                    GenerateHeader="GenerateHeaderOption.Sticky"
                    ResizableColumns=true
                    Pagination="@pagination"
                    Style="width: 100%; height: 405px;overflow:auto;">
        <PropertyColumn Property="@(p=>p.name)" Sortable="true" />
        <PropertyColumn Property="@(p=>p.Price)" Sortable="true" />
        <TemplateColumn Title="Actions" Align="@Align.End">
            <FluentButton aria-label="Edit item" IconEnd="@(new Icons.Regular.Size16.Edit())"
                          OnClick="@(() => OpenDialogAsync(context))" />
            <FluentButton aria-label="Delete item" IconEnd="@(new Icons.Regular.Size16.Delete())"
                          OnClick="@(() => DeleteService(context))" />
        </TemplateColumn>
    </FluentDataGrid>
    <FluentPaginator State="@pagination" />
}
@code {

    [Inject] IServiceService ServiceService { get; set; }
    private IQueryable<Service> services;
    private AddEditServiceDialog addEditServiceDialog;
    PaginationState pagination = new PaginationState { ItemsPerPage = 9 };
    [Parameter ] public string Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
    }

    private async Task LoadServices()
    {
        services = (await ServiceService.GetAll()).AsQueryable();
        StateHasChanged();
    }

    private async Task OpenDialogAsync(Service service)
    {
        DialogParameters parameters = new DialogParameters()
            {
                Title = ((service.id == 0) ? "Add Service" : "Edit Service"),
                PrimaryAction = "Yes",
                PrimaryActionEnabled = false,
                SecondaryAction = "No",
                Width = "800px",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };
        var dialog = await DialogService.ShowDialogAsync<AddEditServiceDialog>(service, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled && result.Data != null)
        {
            await LoadServices();
        }
    }

    private async Task ShowAddModal()
    {
        await OpenDialogAsync(new Service());
    }

    private async void DeleteService(Service service)
    {
        await ServiceService.Delete(service);
        await LoadServices();
    }

    private async void RefreshList()
    {
        await LoadServices();
    }
}